configfile: "config_QC.yaml"
f1 = open(config["sample_file"],"r")
SAMPLES = f1.read().splitlines()
f1.close()
rule all:
	input:
		expand([config["phiXout"]+"/{sample}_trimmed_renamed_cropped_1_kneaddata_paired_1.fastq.gz",
		config["phiXout"]+"/{sample}_trimmed_renamed_cropped_1_kneaddata_paired_2.fastq.gz"],sample=SAMPLES)
rule trim_galore:
	input:
		rawread1=config["raw_read_dir"]+"/{sample}_R1_001.fastq.gz",
		rawread2=config["raw_read_dir"]+"/{sample}_R2_001.fastq.gz"
	params:
		trimout=config["trim_out_path"],
		samp=temp("{sample}")
	singularity:
		config["QCapptainer"]
	output:
		config["trim_out_path"]+"/{sample}_R1_001_val_1.fq.gz",
		config["trim_out_path"]+"/{sample}_R2_001_val_2.fq.gz"
	threads: 20
	resources:
		mem_mb=4000*4,
		disk_mb=10000
	shell:
		"""
		trim_galore --paired {input.rawread1} {input.rawread2} -j {threads} --length 50 --output_dir {params.trimout}
		"""
rule rename:
	input: 
		trim1in=config["trim_out_path"]+"/{sample}_R1_001_val_1.fq.gz",
		trim2in=config["trim_out_path"]+"/{sample}_R2_001_val_2.fq.gz"
	params: trimout=config["trim_out_path"],samp=temp("{sample}")
	output:
		config["trim_out_path"]+"/{sample}_trimmed_1.fastq.gz", 
		config["trim_out_path"]+"/{sample}_trimmed_2.fastq.gz"
	shell:
		"""
		mv {input.trim1in} {params.trimout}/{params.samp}_trimmed_1.fastq.gz
		mv {input.trim2in} {params.trimout}/{params.samp}_trimmed_2.fastq.gz
		"""
rule modify_headers:
	input: 
		trim1in=config["trim_out_path"]+"/{sample}_trimmed_1.fastq.gz",
		trim2in=config["trim_out_path"]+"/{sample}_trimmed_2.fastq.gz"
	params: trimout=config["trim_out_path"],samp=temp("{sample}")
	output:
		config["trim_out_path"]+"/{sample}_trimmed_renamed_1.fastq.gz", 
		config["trim_out_path"]+"/{sample}_trimmed_renamed_2.fastq.gz"
	threads: 20
	resources:
		mem_mb=4000*4,
		disk_mb=10000
	shell:
		"""
		zcat {params.trimout}/{params.samp}_trimmed_1.fastq.gz | awk 'NR%4==1 {{gsub(/ 1/, ""); print $0"#0/1"; next}} {{print}}' | pigz -p 4 > {params.trimout}/{params.samp}_trimmed_renamed_1.fastq.gz 
		zcat {params.trimout}/{params.samp}_trimmed_2.fastq.gz | awk 'NR%4==1 {{gsub(/ 2/, ""); print $0"#0/2"; next}} {{print}}' | sed 's/ 2//g' | sed 's/0\/1/0\/2/g' | pigz -p 4 > {params.trimout}/{params.samp}_trimmed_renamed_2.fastq.gz
		rm {params.trimout}/{params.samp}_trimmed_1.fastq.gz
		rm {params.trimout}/{params.samp}_trimmed_2.fastq.gz
		"""
rule remove_adaptase_and_failedGC_bases:
	input:
		trim1in=config["trim_out_path"]+"/{sample}_trimmed_renamed_1.fastq.gz",
		trim2in=config["trim_out_path"]+"/{sample}_trimmed_renamed_2.fastq.gz"
	params: trimout=config["trim_out_path"],samp=temp("{sample}")
	singularity:
		config["QCapptainer"]
	output:
		config["trim_out_path"]+"/{sample}_trimmed_renamed_cropped_1.fastq.gz", 
		config["trim_out_path"]+"/{sample}_trimmed_renamed_cropped_2.fastq.gz"
	threads: 20
	resources:
		mem_mb=4000*4,
		disk_mb=10000
	shell:
		"""
		seqtk trimfq -e 10 -b 10 {input.trim1in} | pigz -p 4 > {params.trimout}/{params.samp}_trimmed_renamed_cropped_1.fastq.gz
		seqtk trimfq -b 15 {input.trim2in} | pigz -p 4 > {params.trimout}/{params.samp}_trimmed_renamed_cropped_2.fastq.gz
		"""
rule remove_human_contamination:
	input:
		trim1in=config["trim_out_path"]+"/{sample}_trimmed_renamed_cropped_1.fastq.gz",
		trim2in=config["trim_out_path"]+"/{sample}_trimmed_renamed_cropped_2.fastq.gz"
	params: contamout=config["kneaddata_out"],samp=temp("{sample}")
	singularity:
		config["QCapptainer"]
	output:
		config["kneaddata_out"]+"/{sample}_trimmed_renamed_cropped_1_kneaddata_paired_1.fastq.gz", 
		config["kneaddata_out"]+"/{sample}_trimmed_renamed_cropped_1_kneaddata_paired_2.fastq.gz",
		config["kneaddata_out"]+"/{sample}_trimmed_renamed_cropped_1_kneaddata_unmatched_1.fastq.gz",
		config["kneaddata_out"]+"/{sample}_trimmed_renamed_cropped_1_kneaddata_unmatched_2.fastq.gz"
	threads: 4
	resources:
		mem_mb=4000*4,
		disk_mb=10000
	shell:
		"""
		kneaddata --input1 {input.trim1in} --input2 {input.trim2in} --bypass-trf --max-memory 1000m -p 20 -t 20 --reference-db /hg37 --trimmomatic-option MINLEN:70 --remove-intermediate-output --output {params.contamout}
		pigz -p {threads} {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_paired_1.fastq
		pigz -p {threads} {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_paired_2.fastq
		pigz -p {threads} {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_unmatched_1.fastq
		pigz -p {threads} {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_unmatched_2.fastq
		rm {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_hg37dec_v0.1_bowtie2_paired_contam_1.fastq
		rm {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_hg37dec_v0.1_bowtie2_paired_contam_2.fastq
		rm {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_hg37dec_v0.1_bowtie2_unmatched_1_contam.fastq
		rm {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_hg37dec_v0.1_bowtie2_unmatched_2_contam.fastq
		"""
rule remove_phiX_reads:
	input:
		pair1=config["kneaddata_out"]+"/{sample}_trimmed_renamed_cropped_1_kneaddata_paired_1.fastq.gz",
		pair2=config["kneaddata_out"]+"/{sample}_trimmed_renamed_cropped_1_kneaddata_paired_2.fastq.gz"
	params: phiXout=config["phiXout"],contamout=config["kneaddata_out"],samp=temp("{sample}")
	singularity:
		config["QCapptainer"]
	output:
		config["phiXout"]+"/{sample}_trimmed_clean_paired_1.fastq.gz", 
		config["phiXout"]+"/{sample}_trimmed_clean_paired_2.fastq.gz",
		config["phiXout"]+"/{sample}_trimmed_clean_unmatched.fastq.gz"
	threads: 20
	resources:
		mem_mb=4000*4,
		disk_mb=10000
	shell:
		"""
		bowtie2 -p {threads} -x /PhiX174/PhiX174 -1 {input.pair1} -2 {input.pair2} -S {params.phiXout}/{params.samp}_phiXalign.sam
		samtools view -@ 4 -f 4 -b {params.phiXout}/{params.samp}_phiXalign.sam > {params.phiXout}/{params.samp}_phiXalign_unmapped.bam
		samtools sort -@ {threads} -n {params.phiXout}/{params.samp}_phiXalign_unmapped.bam -o {params.phiXout}/{params.samp}_phiXalign_unmapped_sorted.bam
		samtools fastq --threads 4 -1 {params.phiXout}/{params.samp}_trimmed_clean_paired_1.fastq.gz -2 {params.phiXout}/{params.samp}_trimmed_clean_paired_2.fastq.gz -s {params.phiXout}/{params.samp}_trimmed_clean_unmatched.fastq.gz {params.phiXout}/{params.samp}_phiXalign_unmapped_sorted.bam
		rm {params.phiXout}/{params.samp}_phiXalign.sam
		rm {params.phiXout}/{params.samp}_phiXalign_unmapped.bam
		rm {params.phiXout}/{params.samp}_phiXalign_unmapped_sorted.bam
		rm {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_paired_1.fastq.gz
		rm {params.contamout}/{params.samp}_trimmed_renamed_cropped_1_kneaddata_paired_2.fastq.gz
		"""